SECRET_KEY=mysecretkey
DEBUG=true
STAGING=false
DJANGO_ALLOWED_HOSTS=localhost
DOMAIN=
SESSION_COOKIE_SECURE_ENABLED=true
CSRF_COOKIE_SECURE_ENABLED=true
FORUM_WEBHOOK_SECRET=

DATABASE_ENGINE=postgresql
DATABASE_NAME=rigs
DATABASE_USERNAME=rigs
DATABASE_PASSWORD=rigs
DATABASE_HOST=db
DATABASE_PORT=5432

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
EMAIL_USE_SSL=
EMAIL_FROM=

# Web push notifications. Generate with `python manage.py generate_vapid_keys`; leave blank to turn push off.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
SENTRY_DSN=

# Uploaded files (PAT results). Leave the bucket blank to store them on local disk.
# compose.yml defaults these to its bundled S3 service; in production point them at DigitalOcean Spaces
# e.g. AWS_S3_ENDPOINT_URL=https://lon1.digitaloceanspaces.com, AWS_S3_REGION_NAME=lon1
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
# Only for development, where browsers reach the store at a different address from the app. Leave blank in production.
AWS_S3_PUBLIC_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_ADDRESSING_STYLE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
